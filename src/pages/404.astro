---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BrandWordmark } from '@/components/brand/Brand';
import { ArrowLeft, ArrowRight, Compass, MapPin } from 'lucide-react';
import { pageTransition } from '@/lib/motion';
---

<BaseLayout
  title="Page not found — SmartQueue"
  description="That SmartQueue page does not exist. Head back to your dashboard or browse campus services."
  noIndex
>
  <div class="relative flex min-h-dvh flex-col overflow-hidden bg-cream-50">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <img
        src="/campus-background.png"
        alt=""
        width="1600"
        height="1200"
        class="h-full w-full object-cover object-[46%_center] opacity-[0.16]"
      />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(251,250,246,0.9)_0%,rgba(251,250,246,0.97)_60%,#fbfaf6_100%)]"></div>
    </div>

    <header class="relative z-10">
      <div class="page-container flex h-16 items-center justify-between gap-4">
        <a href="/" aria-label="SmartQueue home">
          <BrandWordmark />
        </a>
        <a
          href="/dashboard"
          class="inline-flex min-h-9 items-center gap-1.5 rounded-xl px-3 text-[0.8125rem] font-semibold text-ink-700 transition-colors hover:bg-ink-950/5"
        >
          Dashboard
        </a>
      </div>
    </header>

    <main id="main-content" class="relative z-10 flex flex-1 items-center" transition:name="page" transition:animate={pageTransition}>
      <div class="page-container w-full py-12 sm:py-16">
        <div class="mx-auto grid max-w-4xl gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:gap-12">
          <div class="animate-fade-up">
            <p class="eyebrow text-bamboo-600">
              <Compass size={13} aria-hidden="true" />
              Error 404
            </p>
            <h1 class="mt-4 text-[3.5rem] font-extrabold leading-[0.92] tracking-[-0.065em] text-ink-950 sm:text-[4.5rem]">
              This line
              <span class="block font-display italic tracking-[-0.03em] text-bamboo-800">doesn’t exist.</span>
            </h1>
            <p class="mt-5 max-w-md text-sm leading-relaxed text-ink-500 sm:text-[0.9375rem]">
              The page may have moved, the link may be old, or the ticket was never issued. Your
              actual queue is safe — check your dashboard.
            </p>

            <div class="mt-7 flex flex-col gap-2.5 sm:flex-row">
              <a
                href="/dashboard"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-bamboo-900 px-5 text-sm font-bold text-cream-50 transition-colors hover:bg-bamboo-800 focus-ring"
              >
                Go to dashboard
              </a>
              <a
                href="/services"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-ink-950/12 bg-white px-5 text-sm font-semibold text-ink-800 transition-colors hover:bg-cream-100 focus-ring"
              >
                Browse services
              </a>
            </div>

            <a
              href="/"
              class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-ink-500 transition-colors hover:text-bamboo-800"
            >
              Back to SmartQueue home
            </a>
          </div>

          <div class="animate-fade-up delay-150 hidden justify-self-end sm:block">
            <div class="relative w-full max-w-[19rem] rotate-[-1.5deg]">
              <div class="absolute -inset-3 rounded-[2rem] bg-bamboo-900/8 blur-2xl" aria-hidden="true"></div>
              <div class="relative overflow-hidden rounded-[1.5rem] bg-white p-5 shadow-card ring-1 ring-ink-950/8">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-[0.5625rem] font-extrabold uppercase tracking-[0.18em] text-ink-400">
                      Queue ticket
                    </p>
                    <p class="mt-1.5 text-[2.9rem] font-extrabold leading-none tracking-[-0.06em] text-ink-300 tabular">
                      —-—
                    </p>
                  </div>
                  <span class="mt-1 rounded-full border border-ink-950/10 bg-cream-100 px-2 py-0.5 text-[0.5rem] font-extrabold uppercase tracking-[0.12em] text-ink-400">
                    Void
                  </span>
                </div>

                <div class="my-4 border-t border-dashed border-ink-950/12"></div>

                <div class="space-y-2.5">
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-[0.625rem] font-medium text-ink-400">Office</span>
                    <span class="text-[0.6875rem] font-bold text-ink-700">Not found</span>
                  </div>
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-[0.625rem] font-medium text-ink-400">Status</span>
                    <span class="text-[0.6875rem] font-bold text-ink-700">Off the list</span>
                  </div>
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-[0.625rem] font-medium text-ink-400">Next step</span>
                    <span class="text-[0.6875rem] font-bold text-bamboo-800">Try a real page</span>
                  </div>
                </div>

                <div class="mt-4 flex items-center gap-2 rounded-xl bg-cream-100 px-3 py-2.5 text-[0.625rem] leading-relaxed text-ink-500">
                  <MapPin size={13} className="shrink-0 text-ink-300" aria-hidden="true" />
                  The central queue is still where you left it.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="relative z-10 border-t border-ink-950/8 bg-cream-100/60">
      <div class="page-container flex flex-col gap-2 py-5 text-[0.625rem] text-ink-400 sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} SmartQueue prototype</p>
        <p>SmartQueue is not an official PLMun service.</p>
      </div>
    </footer>
  </div>
</BaseLayout>
