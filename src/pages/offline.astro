---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BrandWordmark } from '@/components/brand/Brand';
import { ArrowRight, RefreshCw, WifiOff } from 'lucide-react';
import { pageTransition } from '@/lib/motion';
---

<BaseLayout
  title="You're offline — SmartQueue"
  description="SmartQueue is offline. Reconnect to resume live queue updates."
  noIndex
>
  <div class="relative flex min-h-dvh flex-col overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <img
        src="/campus-background.png"
        alt=""
        width="1600"
        height="1200"
        class="h-full w-full object-cover object-[52%_center] opacity-[0.14]"
      />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(251,250,246,0.92)_0%,rgba(251,250,246,0.97)_55%,#fbfaf6_100%)]"></div>
    </div>

    <header class="relative z-10">
      <div class="page-container flex h-16 items-center justify-between gap-4">
        <a href="/" aria-label="SmartQueue home">
          <BrandWordmark />
        </a>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-[0.625rem] font-bold uppercase tracking-[0.13em] text-amber-900">
          <WifiOff size={12} aria-hidden="true" />
          Offline
        </span>
      </div>
    </header>

    <main id="main-content" class="relative z-10 flex flex-1 items-center" transition:name="page" transition:animate={pageTransition}>
      <div class="page-container w-full py-12 sm:py-16">
        <div class="mx-auto max-w-xl">
          <div class="animate-fade-up overflow-hidden rounded-[1.5rem] border border-ink-950/8 bg-white shadow-card sm:rounded-[2rem]">
            <div class="border-b border-dashed border-ink-950/10 bg-cream-100/60 px-6 py-8 text-center sm:px-10 sm:py-10">
              <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-50 text-amber-700 ring-1 ring-amber-200">
                <WifiOff size={25} aria-hidden="true" />
              </span>
              <p class="eyebrow mt-5 justify-center text-amber-700">No connection</p>
              <h1 class="mt-3 text-[2rem] font-extrabold leading-[1.05] tracking-[-0.045em] text-ink-950 sm:text-[2.4rem]">
                The line is paused.
                <span class="block font-display italic text-ink-700">Your place is still saved.</span>
              </h1>
              <p class="mx-auto mt-4 max-w-sm text-sm leading-relaxed text-ink-500">
                SmartQueue can show the app shell offline, but live queue numbers need a connection.
                Reconnect to see updated positions and notifications.
              </p>
            </div>

            <div class="px-6 py-6 sm:px-10 sm:py-8">
              <div class="rounded-xl bg-cream-100 p-4">
                <p class="text-xs font-bold text-ink-900">What still works offline</p>
                <ul class="mt-2.5 space-y-2 text-xs leading-relaxed text-ink-500">
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-bamboo-500" aria-hidden="true"></span>
                    Pages you already opened may load from your device.
                  </li>
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-bamboo-500" aria-hidden="true"></span>
                    The last queue snapshot stays visible until a new one arrives.
                  </li>
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-bamboo-500" aria-hidden="true"></span>
                    Do not rely on an offline ticket at the counter. Ask staff to check the central queue.
                  </li>
                </ul>
              </div>

              <div class="mt-5 flex flex-col gap-2.5 sm:flex-row">
                <button
                  type="button"
                  id="offline-retry"
                  class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-xl bg-bamboo-900 px-5 text-sm font-bold text-cream-50 transition-colors hover:bg-bamboo-800 focus-ring"
                >
                  <RefreshCw size={16} aria-hidden="true" />
                  Try again
                </button>
                <a
                  href="/queue"
                  class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-xl border border-ink-950/12 bg-white px-5 text-sm font-semibold text-ink-800 transition-colors hover:bg-cream-100 focus-ring"
                >
                  Open my queue
                </a>
              </div>

              <p id="offline-status" class="mt-4 text-center text-[0.6875rem] font-medium text-ink-400" role="status" aria-live="polite">
                Waiting for a connection…
              </p>
            </div>
          </div>

          <p class="mt-6 text-center text-[0.625rem] leading-relaxed text-ink-400">
            SmartQueue is an independent student prototype, not an official PLMun service.
            Queue activity in this build is simulated.
          </p>
        </div>
      </div>
    </main>

    <footer class="relative z-10 border-t border-ink-950/8 bg-cream-100/60">
      <div class="page-container flex flex-col gap-2 py-5 text-[0.625rem] text-ink-400 sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} SmartQueue prototype</p>
        <p>Pamantasan ng Lungsod ng Muntinlupa · Campus queue prototype</p>
      </div>
    </footer>
  </div>

  <script is:inline data-astro-rerun>
    (function () {
      var retry = document.getElementById('offline-retry');
      var status = document.getElementById('offline-status');

      function update() {
        if (!status) return;
        if (navigator.onLine) {
          status.textContent = 'Connection restored. Reloading…';
          window.setTimeout(function () {
            window.location.reload();
          }, 900);
        } else {
          status.textContent = 'Still offline. Check Wi-Fi or mobile data.';
        }
      }

      if (retry) {
        retry.addEventListener('click', function () {
          update();
          if (!navigator.onLine && status) {
            status.textContent = 'Still offline. Check Wi-Fi or mobile data.';
          }
        });
      }

      window.addEventListener('online', update);
      if (navigator.onLine) update();
    })();
  </script>
</BaseLayout>
