---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BrandMark, BrandWordmark } from '@/components/brand/Brand';
import { ServiceIcon } from '@/components/services/ServiceIcon';
import { CAMPUS_SERVICES } from '@/lib/data/services';
import { OFFICIAL_ADDRESS, OFFICIAL_EMAIL, OFFICIAL_SITE } from '@/lib/config';
import { pageTransition } from '@/lib/motion';
import {
  ArrowRight,
  BellRing,
  Check,
  ChevronRight,
  Clock3,
  MapPin,
  QrCode,
  ShieldCheck,
  Smartphone,
  Users,
} from 'lucide-react';

const featured = CAMPUS_SERVICES.slice(0, 4);
const year = new Date().getFullYear();
---

<BaseLayout
  title="SmartQueue — Skip the line. Keep your time. | PLMun"
  description="SmartQueue helps PLMun students get a campus queue number, track their place, and return when it is almost their turn. One shared queue for online and walk-in students."
>

  <header id="landing-topbar" style="background-color:#FFFFFF;opacity:1;" class="fixed left-1/2 top-3 z-40 w-[calc(100%-1.5rem)] max-w-7xl -translate-x-1/2 rounded-2xl border border-ink-950/10 px-3 py-1.5 shadow-float transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none">
    <div class="page-container flex h-10 items-center justify-between gap-4">
      <a href="/" aria-label="SmartQueue home">
        <BrandWordmark />
      </a>

      <nav class="hidden items-center gap-4 md:flex" aria-label="Landing navigation">
        <a href="#how-it-works" class="text-[0.8125rem] font-semibold text-ink-600 transition-colors hover:text-bamboo-800">How it works</a>
        <a href="#services" class="text-[0.8125rem] font-semibold text-ink-600 transition-colors hover:text-bamboo-800">Services</a>
        <a href="#for-plmun" class="text-[0.8125rem] font-semibold text-ink-600 transition-colors hover:text-bamboo-800">For PLMun</a>
      </nav>

      <div class="flex items-center gap-2">
        <a href="/login" style="background-color:#E8E3D8;color:#1C1917;" class="hidden rounded-xl px-3 py-2 text-[0.75rem] font-semibold transition-colors hover:bg-[#1C1917] hover:text-white sm:inline-flex">Sign in</a>
        <a href="/login" class="inline-flex min-h-9 items-center gap-1 rounded-xl bg-bamboo-900 px-3 text-[0.75rem] font-semibold text-cream-50 transition-colors hover:bg-bamboo-800">
          Get started
        </a>
      </div>
    </div>
  </header>

  <main id="main-content" class="pt-20" transition:name="page" transition:animate={pageTransition}>
    <section class="page-container pt-3 sm:pt-5">
      <div class="relative overflow-hidden rounded-[1.5rem] bg-bamboo-950 sm:rounded-[2rem]">
        <img
          src="/campus-background.png"
          alt=""
          width="1600"
          height="1200"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[58%_center]"
        />
        <div class="absolute inset-0 bg-[linear-gradient(100deg,rgba(7,28,20,0.97)_0%,rgba(7,28,20,0.9)_42%,rgba(7,28,20,0.55)_100%)] max-sm:bg-[linear-gradient(180deg,rgba(7,28,20,0.95)_0%,rgba(7,28,20,0.86)_52%,rgba(7,28,20,0.9)_100%)]"></div>
        <div class="absolute inset-0 opacity-[0.12] [background-image:radial-gradient(rgba(245,242,233,0.7)_0.7px,transparent_0.7px)] [background-size:22px_22px]"></div>

        <div class="relative grid min-h-[36rem] gap-10 px-5 pb-10 pt-10 sm:px-10 sm:pb-12 sm:pt-14 lg:min-h-[41rem] lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:gap-12 lg:px-14 lg:py-16">
          <div class="max-w-[39rem]">
            <div class="animate-fade-up flex flex-wrap items-center gap-2.5">
              <span class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/25 px-3 py-1.5 text-[0.625rem] font-bold uppercase tracking-[0.14em] text-white backdrop-blur-sm">
                <img src="/plmun-seal.jpg" alt="" width="18" height="19" class="h-[17px] w-auto" />
                Built for the PLMun community
              </span>
              <span class="rounded-full border border-white/30 bg-white/25 px-3 py-1.5 text-[0.625rem] font-semibold text-white">
                Prototype preview
              </span>
            </div>

            <h1 class="animate-fade-up delay-75 mt-7 text-[2.65rem] font-extrabold leading-[0.98] tracking-[-0.055em] text-white sm:text-[3.6rem] lg:text-[4.15rem]">
              Skip the line.
              <span class="mt-1 block font-display italic tracking-[-0.025em] text-white">
                Keep your time.
              </span>
            </h1>

            <p class="animate-fade-up delay-150 mt-6 max-w-[32rem] text-[0.9875rem] leading-relaxed text-white sm:text-[1.05rem]">
              Get a queue number for PLMun campus services, track your place from your phone, and
              come back when it’s almost your turn.
            </p>

            <div class="animate-fade-up delay-225 mt-8 flex flex-col gap-2.5 sm:flex-row">
              <a href="/login" style="background-color:#1C1917;color:#FFFFFF;" class="inline-flex min-h-[3.25rem] items-center justify-center gap-2 rounded-xl px-6 text-sm font-bold shadow-[0_14px_34px_-18px_rgba(0,0,0,0.75)] transition-colors hover:bg-black hover:text-white active:bg-black active:text-white">
                Get a queue number
              </a>
              <a href="#how-it-works" class="inline-flex min-h-[3.25rem] items-center justify-center gap-2 rounded-xl border border-white/40 bg-white/15 px-6 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/25">
                How it works
              </a>
            </div>

            <div class="animate-fade-up delay-300 mt-8 flex flex-wrap items-center gap-x-5 gap-y-2.5 text-[0.6875rem] font-medium text-white">
              <span class="inline-flex items-center gap-1.5">
                <Users size={14} className="text-bamboo-300" aria-hidden="true" />
                One shared queue for everyone
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Smartphone size={14} className="text-bamboo-300" aria-hidden="true" />
                No app store needed
              </span>
              <span class="inline-flex items-center gap-1.5">
                <ShieldCheck size={14} className="text-bamboo-300" aria-hidden="true" />
                Guest access available
              </span>
            </div>
          </div>

          <div class="animate-fade-up delay-300 hidden justify-self-end sm:block lg:mt-2">
            <div class="relative w-full max-w-[21rem] rotate-[1.2deg]">
              <div class="absolute -inset-3 rounded-[2rem] bg-bamboo-300/10 blur-2xl" aria-hidden="true"></div>
              <div class="relative overflow-hidden rounded-[1.65rem] border border-[#E2E8F0] bg-white p-6 shadow-[0_2px_10px_rgba(15,23,42,0.08)]">
                <div class="flex items-center justify-between gap-3">
                  <span class="text-[0.5625rem] font-extrabold uppercase tracking-[0.18em] text-[#475569]">
                    Your queue number
                  </span>
                  <span class="rounded-full border border-[#BBF7D0] bg-[#DCFCE7] px-2 py-0.5 text-[0.5rem] font-extrabold uppercase tracking-[0.12em] text-[#166534]">
                    Waiting
                  </span>
                </div>

                <div class="mt-2.5 flex items-end justify-between gap-3">
                  <p class="text-[3.65rem] font-extrabold leading-none tracking-[-0.07em] text-[#102A43] tabular">
                    R-024
                  </p>
                  <span class="mb-1 rounded-md bg-[#F1F5F9] px-1.5 py-0.5 text-[0.5rem] font-bold uppercase tracking-[0.1em] text-[#475569]">
                    Sample
                  </span>
                </div>
                <p class="mt-1.5 text-xs font-semibold text-[#64748B]">Office of the University Registrar</p>

                <div class="my-4 border-t border-dashed border-ink-950/15"></div>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="text-[0.5625rem] font-bold uppercase tracking-[0.13em] text-[#475569]">Now serving</p>
                    <p class="mt-1 text-lg font-extrabold tracking-[-0.03em] text-[#102A43]">R-018</p>
                  </div>
                  <div>
                    <p class="text-[0.5625rem] font-bold uppercase tracking-[0.13em] text-[#475569]">People ahead</p>
                    <p class="mt-1 text-lg font-extrabold tracking-[-0.03em] text-[#102A43]">6</p>
                  </div>
                </div>

                <div class="mt-4 rounded-xl bg-[#F1F5F9] px-3.5 py-3">
                  <div class="flex items-center justify-between text-[0.625rem] font-semibold text-[#475569]">
                    <span>Estimated wait</span>
                    <span class="text-base font-extrabold tracking-[-0.03em] text-[#102A43]">~18 min</span>
                  </div>
                  <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#E2E8F0]">
                    <div class="h-full w-[58%] rounded-full bg-[#102A43]"></div>
                  </div>
                </div>

                <p class="mt-3.5 flex items-start gap-2 text-[0.625rem] leading-relaxed text-[#64748B]">
                  <BellRing size={13} className="mt-0.5 shrink-0 text-bamboo-600" aria-hidden="true" />
                  You don’t have to wait here. We’ll tell you when you’re almost up.
                </p>
              </div>
            </div>
            <p class="mt-3 text-center text-[0.5625rem] font-medium uppercase tracking-[0.12em] text-white">
              Example ticket · queue data is simulated
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="page-container pt-16 sm:pt-20 lg:pt-24">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div>
          <p class="eyebrow text-bamboo-600">How it works</p>
          <h2 class="mt-3 max-w-md text-[2rem] font-extrabold leading-[1.04] tracking-[-0.045em] text-ink-950 sm:text-[2.5rem]">
            Get your number.
            <span class="block font-display italic text-ink-700">Go do what you need to do.</span>
          </h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-ink-500 sm:text-[0.9375rem] lg:justify-self-end">
          SmartQueue is for the in-between moments — the 20-minute wait before a document, the
          line at the cashier, the ID you need to claim. Join from your phone, then get on with your
          day.
        </p>
      </div>

      <div id="how-it-works" class="mt-10 grid gap-3.5 md:grid-cols-3">
        <article class="surface rounded-2xl p-5 sm:p-6">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-bamboo-900 text-cream-50">
              <QrCode size={19} aria-hidden="true" />
            </span>
            <span class="text-[0.625rem] font-extrabold tracking-[0.18em] text-ink-300">01</span>
          </div>
          <h3 class="mt-5 text-base font-bold text-ink-950">Pick a service</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">
            Find the office you need, choose what you’re requesting, and check the current line.
          </p>
        </article>

        <article class="surface rounded-2xl p-5 sm:p-6">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-bamboo-900 text-cream-50">
              <Clock3 size={19} aria-hidden="true" />
            </span>
            <span class="text-[0.625rem] font-extrabold tracking-[0.18em] text-ink-300">02</span>
          </div>
          <h3 class="mt-5 text-base font-bold text-ink-950">Get your number</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">
            Your number joins the same line as walk-ins. No separate digital queue, no cutting
            ahead.
          </p>
        </article>

        <article class="surface rounded-2xl p-5 sm:p-6">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-bamboo-900 text-cream-50">
              <BellRing size={19} aria-hidden="true" />
            </span>
            <span class="text-[0.625rem] font-extrabold tracking-[0.18em] text-ink-300">03</span>
          </div>
          <h3 class="mt-5 text-base font-bold text-ink-950">Come back when called</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">
            Track your place and get a notification when you’re next or when it’s time to head to
            the counter.
          </p>
        </article>
      </div>

      <div class="mt-4 overflow-hidden rounded-2xl border border-bamboo-900/10 bg-bamboo-900 p-5 text-cream-50 sm:p-7">
        <div class="grid gap-7 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
          <div>
            <p class="eyebrow text-bamboo-300">One central queue</p>
            <h3 class="mt-2.5 text-xl font-bold tracking-[-0.03em] sm:text-2xl">
              Online or walk-in, it’s the same line.
            </h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-cream-100/85">
              Every entry point feeds one queue per service. If eight students are already waiting,
              the next digital ticket is number nine — not number one.
            </p>
          </div>

          <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
            <div class="flex flex-wrap gap-2 sm:flex-col sm:items-stretch">
              <span class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/8 px-3 py-2 text-[0.6875rem] font-semibold text-cream-50">
                <Smartphone size={14} aria-hidden="true" /> PWA / QR
              </span>
              <span class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/8 px-3 py-2 text-[0.6875rem] font-semibold text-cream-50">
                <Users size={14} aria-hidden="true" /> Walk-in / kiosk
              </span>
            </div>
            <div class="flex-1 rounded-xl border border-white/15 bg-cream-50 p-3.5 text-ink-950">
              <div class="flex items-center justify-between">
                <span class="text-[0.5625rem] font-extrabold uppercase tracking-[0.16em] text-ink-400">Central queue</span>
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              </div>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <span class="rounded-md bg-cream-200 px-1.5 py-1 text-[0.625rem] font-bold text-ink-500">R-018</span>
                <span class="rounded-md bg-cream-200 px-1.5 py-1 text-[0.625rem] font-bold text-ink-500">R-019</span>
                <span class="rounded-md bg-cream-200 px-1.5 py-1 text-[0.625rem] font-bold text-ink-500">R-020</span>
                <span class="rounded-md bg-cream-200 px-1.5 py-1 text-[0.625rem] font-bold text-ink-500">R-021</span>
                <span class="rounded-md bg-bamboo-100 px-1.5 py-1 text-[0.625rem] font-bold text-bamboo-800">R-024</span>
              </div>
              <p class="mt-2 text-[0.625rem] font-medium text-ink-400">Next number is issued after the last one.</p>
            </div>
            <div class="flex items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/8 px-3 py-3 text-[0.6875rem] font-semibold text-cream-50 sm:flex-col sm:px-4 sm:text-center">
              <BellRing size={16} className="text-gold-400" aria-hidden="true" />
              <span>Your turn</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="page-container pt-16 sm:pt-20 lg:pt-24">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow text-bamboo-600">Campus services</p>
          <h2 class="mt-3 text-[2rem] font-extrabold leading-[1.05] tracking-[-0.045em] text-ink-950 sm:text-[2.5rem]">
            Start with the office you need.
          </h2>
        </div>
        <a href="/login?next=/services" class="group inline-flex items-center gap-1.5 text-sm font-semibold text-bamboo-800 transition-colors hover:text-bamboo-600">
          Browse all services
        </a>
      </div>

      <div class="mt-8 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((service) => (
          <a
            href={`/login?next=/services/${service.id}`}
            class="group flex flex-col rounded-2xl border border-ink-950/8 bg-white p-4.5 shadow-soft transition-all duration-200 hover:-translate-y-1 hover:border-bamboo-900/15 hover:shadow-card sm:p-5"
          >
            <div class="flex items-start justify-between">
              <ServiceIcon service={service} />
            </div>
            <h3 class="mt-4 text-[0.9375rem] font-bold tracking-[-0.02em] text-ink-950">{service.name}</h3>
            <p class="mt-1 text-[0.6875rem] font-medium leading-relaxed text-ink-500">{service.office}</p>
            <div class="mt-auto flex items-center gap-1.5 pt-4 text-[0.6875rem] font-medium text-ink-400">
              <MapPin size={12} aria-hidden="true" />
              {service.location}
            </div>
          </a>
        ))}
      </div>
      <p class="mt-3 text-[0.6875rem] leading-relaxed text-ink-400">
        Service names and locations are based on the official PLMun website and Citizen’s Charter.
        Queue activity shown in this prototype is simulated.
      </p>
    </section>

    <section id="for-plmun" class="page-container pt-16 sm:pt-20 lg:pt-24">
      <div class="overflow-hidden rounded-[1.5rem] border border-ink-950/8 bg-white sm:rounded-[2rem]">
        <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
          <div class="p-6 sm:p-9 lg:p-11">
            <div class="flex items-center gap-3">
              <img src="/plmun-seal.jpg" alt="" width="46" height="47" class="h-11 w-auto" />
              <div>
                <p class="text-[0.5625rem] font-bold uppercase tracking-[0.16em] text-ink-400">Institutional context</p>
                <p class="mt-0.5 text-xs font-semibold text-ink-800">Pamantasan ng Lungsod ng Muntinlupa</p>
              </div>
            </div>

            <h2 class="mt-6 text-[1.85rem] font-extrabold leading-[1.06] tracking-[-0.04em] text-ink-950 sm:text-[2.3rem]">
              Built around the places
              <span class="block font-display italic text-bamboo-800">students already go.</span>
            </h2>
            <p class="mt-4 max-w-lg text-sm leading-relaxed text-ink-500">
              SmartQueue is designed around PLMun’s campus offices — the Registrar, Finance Office,
              Office of Student Affairs, MIS Office, Guidance and Counseling, and the Medical and
              Dental Clinic. Office details come from the University’s public pages.
            </p>

            <div class="mt-7 grid gap-3 sm:grid-cols-2">
              <div class="rounded-xl bg-cream-100 p-3.5">
                <p class="flex items-center gap-1.5 text-[0.5625rem] font-extrabold uppercase tracking-[0.14em] text-ink-400">
                  <MapPin size={12} aria-hidden="true" /> Campus address
                </p>
                <p class="mt-1.5 text-xs font-medium leading-relaxed text-ink-700">{OFFICIAL_ADDRESS}</p>
              </div>
              <div class="rounded-xl bg-cream-100 p-3.5">
                <p class="flex items-center gap-1.5 text-[0.5625rem] font-extrabold uppercase tracking-[0.14em] text-ink-400">
                  <Clock3 size={12} aria-hidden="true" /> Registrar hours
                </p>
                <p class="mt-1.5 text-xs font-medium leading-relaxed text-ink-700">
                  Monday–Friday · 8:00 AM–5:00 PM
                </p>
                <p class="mt-0.5 text-[0.625rem] text-ink-400">As posted by the Office of the University Registrar</p>
              </div>
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2">
              <a href={OFFICIAL_SITE} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-bamboo-800 hover:text-bamboo-600">
                Visit the official PLMun website
              </a>
              <a href={`mailto:${OFFICIAL_EMAIL}`} class="text-xs font-medium text-ink-500 hover:text-ink-800">
                {OFFICIAL_EMAIL}
              </a>
            </div>
          </div>

          <div class="relative min-h-[17rem] overflow-hidden bg-bamboo-950 lg:min-h-full">
            <img
              src="/campus-background.png"
              alt=""
              width="1600"
              height="1200"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover object-[52%_center] opacity-70"
            />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,28,20,0.25)_0%,rgba(7,28,20,0.88)_100%)]"></div>
            <div class="relative flex h-full min-h-[17rem] flex-col justify-end p-6 sm:p-8">
              <div class="flex flex-wrap gap-2">
                {['Registrar', 'Cashier', 'Student Affairs', 'Student ID', 'Guidance', 'Clinic'].map((label) => (
                  <span class="rounded-full border border-white/15 bg-white/10 px-2.5 py-1 text-[0.625rem] font-semibold text-white backdrop-blur-sm">
                    {label}
                  </span>
                ))}
              </div>
              <p class="mt-5 max-w-sm text-sm leading-relaxed text-white">
                One shared line per service. Digital tickets, QR entries, kiosks, and walk-ins all
                join the same queue.
              </p>
              <p class="mt-4 flex items-center gap-2 text-[0.625rem] font-semibold uppercase tracking-[0.12em] text-white">
                <Check size={13} aria-hidden="true" />
                No separate digital lane
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="page-container py-16 sm:py-20 lg:py-24">
      <div class="relative overflow-hidden rounded-[1.5rem] bg-bamboo-900 px-6 py-10 text-center sm:rounded-[2rem] sm:px-10 sm:py-14">
        <div class="absolute inset-0 opacity-20 [background-image:radial-gradient(rgba(245,242,233,0.6)_0.7px,transparent_0.7px)] [background-size:20px_20px]" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-2xl">
          <BrandMark size={42} className="mx-auto" />
          <h2 class="mt-5 text-[2rem] font-extrabold leading-[1.04] tracking-[-0.045em] text-cream-50 sm:text-[2.75rem]">
            Your next queue
            <span class="font-display italic text-cream-100/90"> starts here.</span>
          </h2>
          <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-cream-100/80">
            Sign in with your PLMun email or continue as a guest. Getting a number takes less than
            a minute.
          </p>
          <div class="mt-7 flex flex-col justify-center gap-2.5 sm:flex-row">
            <a href="/login" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-cream-50 px-6 text-sm font-bold text-bamboo-900 transition-colors hover:bg-white">
              Get started
            </a>
            <a href="/login?guest=1" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/20 bg-white/5 px-6 text-sm font-semibold text-cream-50 transition-colors hover:bg-white/10">
              Continue as guest
            </a>
          </div>
        </div>
      </div>
    </section>
  <style>
    .reveal { opacity: 0; transform: translateY(100px) scale(0.92); transition: opacity 1400ms cubic-bezier(0.16,1,0.3,1), transform 1400ms cubic-bezier(0.16,1,0.3,1); }
    .reveal.in { opacity: 1; transform: translateY(0) scale(1); }
    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
  </style>
  <script is:inline data-astro-rerun>
    (function(){
      var els = document.querySelectorAll('main section, main .rounded-2xl, main .rounded-xl');
      els.forEach(function(e){ e.classList.add('reveal'); });
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){ en.target.classList.add('in'); }
        });
      }, { threshold: 0.1 });
      els.forEach(function(e){ io.observe(e); });
    })();
  </script>
  </main>

  <script is:inline data-astro-rerun>
    (function () {
      var header = document.getElementById('landing-topbar');
      if (!header) return;
      var lastY = window.scrollY;
      var ticking = false;
      var threshold = 12;
      var update = function () {
        var currentY = window.scrollY;
        var delta = currentY - lastY;
        if (currentY <= threshold) {
          header.style.transform = 'translateX(-50%) translateY(0)';
        } else if (Math.abs(delta) > threshold) {
          header.style.transform = delta > 0 ? 'translateX(-50%) translateY(-140%)' : 'translateX(-50%) translateY(0)';
          lastY = currentY;
        }
        ticking = false;
      };
      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      }, { passive: true });
    })();
  </script>



